{
  "name": "acute-code",
  "version": "0.49.0",
  "private": true,
  "license": "UNLICENSED",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "vite",
    "dev:full": "node scripts/dev.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "vitest run --config tests/e2e/vitest.config.ts",
    "build": "pnpm --filter shared run build && pnpm --filter agent-core run build && vite build",
    "license:audit": "node scripts/license-audit.mjs",
    "dashboard:publish-screenshots": "node scripts/dashboard/publish-screenshots.mjs",
    "docs:check": "node scripts/docs/check-stale.mjs",
    "version:get": "node scripts/release/version.mjs get",
    "version:check": "node scripts/release/version.mjs check",
    "version:set": "node scripts/release/version.mjs set",
    "verify:round": "node scripts/verify-round.mjs",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build && pnpm test:e2e && pnpm license:audit"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "^1.1.23",
    "@tanstack/react-query": "^5.101.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.1.1",
    "lucide-react": "^1.33.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.2",
    "shared": "workspace:*",
    "tailwind-merge": "^3.6.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "happy-dom": "^15.11.7",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
