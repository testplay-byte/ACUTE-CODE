{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ACUTE-CODE",
  "version": "0.122.0",
  "identifier": "com.acutecode.app",
  "mainBinaryName": "ACUTE-CODE",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ACUTE-CODE",
        "width": 1280,
        "height": 800,
        "minWidth": 1000,
        "minHeight": 620,
        "decorations": false,
        "center": true
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "resources": {
      "staging/sidecar/": "sidecar/"
    },
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
