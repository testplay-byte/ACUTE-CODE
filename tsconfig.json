{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  // Dual duty: base config for the agent-core/shared build tsconfigs AND the
  // noEmit program that typechecks the entire workspace (frontend, shared,
  // agent-core, and all test files) for the root `pnpm typecheck` script.
  "include": ["src", "vite.config.ts", "shared/src", "agent-core/src", "agent-core/tests"]
}
